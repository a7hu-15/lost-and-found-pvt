# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES (AWS ECS & Fargate)
# ==========================================
# Managed automatically via Terraform IaC (infra/terraform/)

# --- Core Security ---
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE

# --- Database (Amazon RDS PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<rds_endpoint>:5432/refynd

# --- AWS Cloud Storage & Moderation ---
AWS_REGION=us-east-1
AWS_S3_BUCKET=refynd-uploads-prod-a91aeec0
AWS_CLOUDFRONT_DOMAIN=d25eqjxhksqlbh.cloudfront.net
ENABLE_REKOGNITION_MODERATION=true
REKOGNITION_CONFIDENCE_THRESHOLD=70.0
USE_CLOUD_STORAGE=true

# --- Email Notifications & Support (Google SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cloudlostfound.platform@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=ReFynd <cloudlostfound.platform@gmail.com>
SUPPORT_EMAIL=cloudlostfound.platform@gmail.com
MOCK_SMTP=false

# --- Frontend Domain & CORS ---
FRONTEND_URL=https://d25eqjxhksqlbh.cloudfront.net
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://d25eqjxhksqlbh.cloudfront.net"]
